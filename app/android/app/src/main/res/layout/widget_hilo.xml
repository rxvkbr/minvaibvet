<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wh_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="12dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:letterSpacing="0.08" android:maxLines="1" android:ellipsize="end"
        android:text="@string/g_hl_title" android:textColor="#FFF0A93A" android:textSize="11sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/wh_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFF5D47" android:textSize="40sp" android:textStyle="bold" />
        <TextView android:id="@+id/wh_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp"
            android:maxLines="3" android:ellipsize="end" android:textColor="#FFF2E3BD" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal">
        <TextView android:id="@+id/wh_up" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/btn_amber"
            android:gravity="center" android:text="@string/g_hl_up" android:textColor="#FF1A100B" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/wh_down" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/btn_neon"
            android:gravity="center" android:text="@string/g_hl_down" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/wh_streak" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#FFB9A47F" android:textSize="10sp" />
</LinearLayout>
