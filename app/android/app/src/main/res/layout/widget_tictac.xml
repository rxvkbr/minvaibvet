<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wt_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:letterSpacing="0.08"
            android:maxLines="1" android:ellipsize="end" android:text="@string/g_tt_title" android:textColor="#FFF0A93A" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/wt_new" android:layout_width="wrap_content" android:layout_height="28dp" android:background="@drawable/btn_amber"
            android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="@string/g_new" android:textColor="#FF1A100B" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp" android:orientation="horizontal">
        <TextView android:id="@+id/wt_c0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/btn_ivory" android:gravity="center" android:textColor="#FF1A100B" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/wt_c1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp"
            android:background="@drawable/btn_ivory" android:gravity="center" android:textColor="#FF1A100B" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/wt_c2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp"
            android:background="@drawable/btn_ivory" android:gravity="center" android:textColor="#FF1A100B" android:textSize="22sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp" android:orientation="horizontal">
        <TextView android:id="@+id/wt_c3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/btn_ivory" android:gravity="center" android:textColor="#FF1A100B" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/wt_c4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp"
            android:background="@drawable/btn_ivory" android:gravity="center" android:textColor="#FF1A100B" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/wt_c5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp"
            android:background="@drawable/btn_ivory" android:gravity="center" android:textColor="#FF1A100B" android:textSize="22sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp" android:orientation="horizontal">
        <TextView android:id="@+id/wt_c6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/btn_ivory" android:gravity="center" android:textColor="#FF1A100B" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/wt_c7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp"
            android:background="@drawable/btn_ivory" android:gravity="center" android:textColor="#FF1A100B" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/wt_c8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp"
            android:background="@drawable/btn_ivory" android:gravity="center" android:textColor="#FF1A100B" android:textSize="22sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/wt_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:maxLines="2" android:ellipsize="end" android:textColor="#FFF2E3BD" android:textSize="12sp" />
    <TextView android:id="@+id/wt_score" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFB9A47F" android:textSize="10sp" />
</LinearLayout>
