{
  "name": "vaibvet-office",
  "productName": "Вайбкет Офіс",
  "version": "1.0.0",
  "description": "Вайбкет Офіс: продуктивність, яка працює сама. Сатира Мінвайбкету.",
  "author": "Мінвайбкет",
  "homepage": "https://minvaibvet.pp.ua/office",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "prep": "node scripts/prep.js",
    "start": "npm run prep && electron .",
    "dist:win": "npm run prep && electron-builder --win --x64",
    "dist:mac": "npm run prep && electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ua.pp.minvaibvet.office",
    "productName": "Vaibvet Office",
    "artifactName": "VaibvetOffice-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "www/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extendInfo": {
        "CFBundleDisplayName": "Вайбкет Офіс",
        "LSApplicationCategoryType": "public.app-category.entertainment",
        "NSCameraUsageDescription": "Камера потрібна Диригенту й Маестро, щоб бачити рух руки. Відео нікуди не надсилається."
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Вайбкет Офіс",
      "artifactName": "VaibvetOffice-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Вайбкет Офіс"
    },
    "portable": {
      "artifactName": "VaibvetOffice-${version}-portable.${ext}"
    },
    "executableName": "VaibvetOffice"
  }
}
